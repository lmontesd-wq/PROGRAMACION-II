<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VeterinariaV2.Vistas.UsuariosWindow"
        Title="Usuarios" Width="800" Height="520">
  <Grid ColumnDefinitions="300,*" Margin="16">
    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,16,0">
      <TextBlock Text="Nombre completo"/>
      <TextBox x:Name="txtNombreCompleto"/>
      <TextBlock Text="Nombre de usuario"/>
      <TextBox x:Name="txtNombreUsuario"/>
      <TextBlock Text="Contraseña (en edición: vacío = no cambiarla)"/>
      <TextBox x:Name="txtClave" PasswordChar="*"/>
      <TextBlock Text="Rol"/>
      <ComboBox x:Name="cmbRol" HorizontalAlignment="Stretch"/>
      <CheckBox x:Name="chkActivo" Content="Activo" IsChecked="True"/>
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
        <Button Content="Nuevo" Click="BtnNuevo_Click"/>
        <Button Content="Guardar" Click="BtnGuardar_Click"/>
        <Button Content="Eliminar" Click="BtnEliminar_Click"/>
      </StackPanel>
      <TextBlock x:Name="lblMensaje" Foreground="OrangeRed" TextWrapping="Wrap"/>
    </StackPanel>
    <ListBox x:Name="lstUsuarios" Grid.Column="1"
             SelectionChanged="LstUsuarios_SelectionChanged"/>
  </Grid>
</Window>
